NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin used for magic-link emails (Supabase needs a full URL for
# emailRedirectTo). Defaults to http://127.0.0.1:3000 if unset — override in
# deployed environments (e.g. https://gymtrack.vercel.app).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
